{
  "name": "zli-v2",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "boundaries": "node scripts/enforce-boundaries.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "desktop:pack": "pnpm --filter @zli-v2/desktop run pack",
    "desktop:pack:prebuilt": "pnpm --filter @zli-v2/desktop run pack:prebuilt",
    "desktop:dir": "pnpm --filter @zli-v2/desktop run pack:dir",
    "desktop:release": "pnpm --filter @zli-v2/desktop run release",
    "desktop:dev": "pnpm run build && node scripts/desktop-dev.mjs",
    "e2e": "playwright test",
    "build": "node scripts/build.mjs && pnpm run web:build",
    "web:build": "pnpm --filter @zli-v2/web exec vite build",
    "test": "vitest run",
    "lint": "biome lint .",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm run boundaries && pnpm run format:check && pnpm run lint && pnpm run test && pnpm run typecheck"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "http-cache-semantics": "4.3.0",
      "source-map-js": "1.2.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.60.0",
    "electron": "44.10.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.1",
    "playwright-core": "1.60.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
