{
  "name": "zli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir v2 run desktop:dev",
    "build": "pnpm --dir v2 run build",
    "test": "pnpm --dir v2 run test",
    "test:ui": "node --test tests/uiDesignContract.test.mjs",
    "verify": "pnpm --dir v2 run verify",
    "lint": "pnpm --dir v2 run lint",
    "desktop:dev": "pnpm --dir v2 run desktop:dev",
    "desktop:dir": "pnpm --dir v2 run desktop:dir",
    "desktop:pack": "pnpm --dir v2 run desktop:pack",
    "legacy:dev": "vite",
    "legacy:build": "tsc && vite build",
    "legacy:test": "node --experimental-strip-types --test tests/*.test.mjs",
    "legacy:test:ui": "node --test tests/uiDesignContract.test.mjs",
    "legacy:preview": "vite preview",
    "legacy:lint": "eslint src",
    "legacy:tauri": "node scripts/run-tauri.mjs",
    "tauri": "pnpm --dir v2 run desktop:dev",
    "preview": "pnpm --dir v2 --filter @zli-v2/web exec vite preview",
    "v2": "pnpm --dir v2",
    "v2:verify": "pnpm --dir v2 run verify",
    "v2:build": "pnpm --dir v2 run build",
    "v2:desktop": "pnpm --dir v2 run desktop:dev",
    "v2:desktop:dir": "pnpm --dir v2 run desktop:dir",
    "v2:desktop:pack": "pnpm --dir v2 run desktop:pack",
    "prepare:zli-dev": "cargo build --manifest-path src-tauri/Cargo.toml --bin zli --bin zli-browser-use",
    "prepare:zli-sidecar": "node scripts/prepare-zli-sidecar.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.0.16"
  }
}
